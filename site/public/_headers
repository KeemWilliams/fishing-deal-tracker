# Cloudflare Pages headers. This site ships no inline <script>/<style> (every
# script is an external same-origin file under /scripts/, every stylesheet is
# an Astro/Tailwind-built same-origin file under /_astro/), so the CSP below
# has no 'unsafe-inline' anywhere.
#
# connect-src allows https: broadly (not a single pinned host) because the
# only client-side network call this site makes -- the stale-feed poll in
# public/scripts/feed-status.js -- fetches PUBLIC_FEED_BASE_URL, which is a
# per-deploy environment variable this static file can't see at request time.
# If/when that host is fixed for a given deploy, tighten this to that exact
# origin instead of 'https:'.
#
# `/*` (not `/` or a per-route list) so this applies to every path regardless
# of the site's trailingSlash:'always' config or Cloudflare's own redirect
# handling -- avoids the trailing-slash mismatch where a headers rule only
# matches one of `/foo` / `/foo/` and silently misses the other.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
