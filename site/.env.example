# Base URL the site reads the published deals feed from, no trailing slash.
# In production this points at the public R2 bucket / CDN path that the
# fpt export job promotes to `latest/` (see architecture doc section 3.4).
# Example: https://data.tackledeals.example/latest
#
# Left unset in local dev, the site falls back to the bundled sample feed
# in sample-data/ so `npm run dev` and `npm run build` work with no backend.
PUBLIC_FEED_BASE_URL=
