---
import type { DealQualityTier } from '../lib/types';
import { dealTierLabel } from '../lib/format';

interface Props {
  tier: DealQualityTier;
}

const { tier } = Astro.props;
const label = dealTierLabel(tier);

// EXCEPTIONAL gets a light accent tint since it's the rarest/best tier;
// STRONG and GOOD stay neutral so the accent color reads as reserved for
// the discount figure, per the design brief.
const tierClass: Record<DealQualityTier, string> = {
  EXCEPTIONAL: 'bg-accent-500/10 text-accent-700 dark:text-accent-500',
  STRONG: 'bg-neutral-900/5 text-neutral-700 dark:bg-white/10 dark:text-neutral-200',
  GOOD: 'bg-neutral-900/5 text-neutral-600 dark:bg-white/10 dark:text-neutral-300',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide',
    tierClass[tier],
  ]}
  data-testid="deal-tier-badge"
>
  {label}
</span>
