---
interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
---

<div
  id="deals-empty-state"
  class="mt-4 rounded-2xl border border-dashed border-neutral-300 bg-white p-10 text-center dark:border-white/15 dark:bg-neutral-900"
  hidden={hidden}
>
  <p class="text-base font-semibold text-neutral-700 dark:text-neutral-200">No deals match those filters right now.</p>
  <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
    Try a different category or retailer, or check back later — new deep discounts get confirmed
    throughout the day.
  </p>
</div>
