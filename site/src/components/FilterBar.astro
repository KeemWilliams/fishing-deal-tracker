---
import { categoryLabel } from '../lib/format';
import { BASE_URL } from '../lib/site-config';

interface Props {
  categories: string[];
  retailers: { slug: string; name: string }[];
}

const { categories, retailers } = Astro.props;

const selectClass =
  'rounded-full border border-neutral-200 bg-white px-3 py-1.5 text-sm text-neutral-700 shadow-sm transition-colors focus-visible:border-accent-500 dark:border-white/10 dark:bg-neutral-900 dark:text-neutral-200';
---

<form
  id="deal-filters"
  class="flex flex-wrap items-end gap-4 rounded-2xl border border-neutral-200/80 bg-white p-4 shadow-[var(--shadow-card)] dark:border-white/10 dark:bg-neutral-900"
  aria-label="Filter and sort deals"
>
  <div class="flex flex-col gap-1">
    <label for="filter-category" class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Category</label>
    <select id="filter-category" name="category" data-testid="filter-category" class={selectClass}>
      <option value="all">All categories</option>
      {categories.map((category) => (
        <option value={category}>{categoryLabel(category)}</option>
      ))}
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="filter-retailer" class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Retailer</label>
    <select id="filter-retailer" name="retailer" data-testid="filter-retailer" class={selectClass}>
      <option value="all">All retailers</option>
      {retailers.map((retailer) => (
        <option value={retailer.slug}>{retailer.name}</option>
      ))}
    </select>
  </div>

  <fieldset class="flex flex-col gap-1">
    <legend class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Condition</legend>
    <div class="flex gap-3 pt-1.5 text-sm text-neutral-700 dark:text-neutral-200">
      <label class="flex items-center gap-1.5">
        <input type="radio" name="condition" value="all" checked data-testid="filter-condition-all" class="accent-accent-500" />
        All
      </label>
      <label class="flex items-center gap-1.5">
        <input type="radio" name="condition" value="new" data-testid="filter-condition-new" class="accent-accent-500" />
        New
      </label>
      <label class="flex items-center gap-1.5">
        <input type="radio" name="condition" value="used" data-testid="filter-condition-used" class="accent-accent-500" />
        Used
      </label>
    </div>
  </fieldset>

  <div class="flex flex-col gap-1">
    <label for="filter-sort" class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Sort by</label>
    <select id="filter-sort" name="sort" data-testid="filter-sort" class={selectClass}>
      <option value="discount_desc">Biggest discount</option>
      <option value="price_asc">Lowest price</option>
      <option value="newest">Newest</option>
    </select>
  </div>

  <p class="text-xs text-neutral-400 dark:text-neutral-500" id="filter-result-count" role="status" aria-live="polite"></p>
</form>

<script is:inline src={`${BASE_URL}scripts/filters.js`} defer></script>
