---
import type { Deal } from '../lib/types';
import { formatCents, formatPct, formatRelativeTime, categoryLabel } from '../lib/format';
import { safeRetailerUrl } from '../lib/safe-url';
import ConditionBadge from './ConditionBadge.astro';

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;

const laneLabel: Record<Deal['lane'], string> = {
  VERIFIED: 'Verified deal',
  CLAIMED: "Retailer's claimed price",
  USED: 'Used gear deal',
};

const laneClass: Record<Deal['lane'], string> = {
  VERIFIED: 'bg-deal-50 text-deal-600',
  CLAIMED: 'bg-slate-100 text-slate-600',
  USED: 'bg-amber-50 text-amber-700',
};

let referenceNote = '';
if (deal.lane === 'VERIFIED' && deal.reference) {
  referenceNote = `vs ${deal.reference.label}`;
} else if (deal.lane === 'CLAIMED' && deal.claimed_reference) {
  referenceNote = `vs ${deal.retailer_name ?? deal.retailer_slug}'s listed price`;
} else if (deal.lane === 'USED' && deal.reference) {
  referenceNote = `vs current new price (${deal.reference.label})`;
}

const productHref = `/p/${deal.product_slug}/`;
const priceToShow = deal.landed_price_cents ?? deal.price_cents;
const showsLandedNote = deal.landed_price_cents !== null && deal.landed_price_cents !== deal.price_cents;
const outboundUrl = safeRetailerUrl(deal.retailer_url, deal.retailer_slug);
---

<article
  class="flex h-full flex-col gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md"
  data-deal-card
  data-category={deal.category}
  data-retailer={deal.retailer_slug}
  data-condition-group={deal.condition === 'NEW' ? 'new' : 'used'}
  data-discount={deal.discount_pct}
  data-price={priceToShow}
  data-confirmed-at={deal.last_confirmed_at}
>
  <div class="flex items-start justify-between gap-2">
    <span class:list={['inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold', laneClass[deal.lane]]}>
      {laneLabel[deal.lane]}
    </span>
    <span class="text-sm font-bold text-deal-600">{formatPct(deal.discount_pct)} off</span>
  </div>

  <div>
    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">{categoryLabel(deal.category)} · {deal.brand}</p>
    <h3 class="mt-0.5 text-base font-semibold leading-snug text-slate-900">
      <a href={productHref} class="hover:underline">{deal.product_name}</a>
    </h3>
    <p class="text-sm text-slate-500">{deal.variant_label}</p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <ConditionBadge condition={deal.condition} />
    {deal.availability === 'STORE_ONLY' && (
      <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
        In store only
      </span>
    )}
  </div>

  <div class="mt-auto">
    <p class="text-2xl font-bold text-slate-900">
      {formatCents(priceToShow)}
      {showsLandedNote && <span class="ml-1 text-xs font-normal text-slate-500">shipped</span>}
    </p>
    {referenceNote && <p class="text-xs text-slate-500">{referenceNote}</p>}

    {deal.lane !== 'CLAIMED' && deal.claimed_reference && (
      <p class="mt-1 text-xs italic text-slate-400">
        {deal.retailer_name ?? deal.retailer_slug}'s {deal.claimed_reference.kind === 'MSRP' ? 'MSRP' : 'listed price'} is {formatCents(deal.claimed_reference.cents)}
        {deal.claimed_reference.inflated_vs_reference && " — higher than any price we've tracked"}.
      </p>
    )}
  </div>

  <div class="flex items-center justify-between border-t border-slate-100 pt-3 text-xs text-slate-500">
    <span>{deal.retailer_name ?? deal.retailer_slug} · checked {formatRelativeTime(deal.last_confirmed_at)}</span>
  </div>

  {outboundUrl ? (
    <a
      href={outboundUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700"
      data-testid="deal-outbound-link"
    >
      View at {deal.retailer_name ?? deal.retailer_slug}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  ) : (
    <p class="inline-flex items-center justify-center rounded-md bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-500" data-testid="deal-outbound-link-unavailable">
      Link unavailable
    </p>
  )}
</article>
