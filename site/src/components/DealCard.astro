---
import type { Deal } from '../lib/types';
import { formatRelativeTime, categoryLabel, discountReferenceCaption, displayProductName } from '../lib/format';
import { safeRetailerUrl } from '../lib/safe-url';
import { BASE_URL } from '../lib/site-config';
import ConditionBadge from './ConditionBadge.astro';
import ProductImage from './ProductImage.astro';
import DiscountPriceBlock from './DiscountPriceBlock.astro';

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;

const laneLabel: Record<Deal['lane'], string> = {
  VERIFIED: 'Verified',
  CLAIMED: "Retailer's claimed price",
  USED: 'Used gear',
};

const laneClass: Record<Deal['lane'], string> = {
  VERIFIED: 'bg-deal-50 text-deal-600 dark:bg-deal-600/10 dark:text-deal-600',
  CLAIMED: 'bg-neutral-100 text-neutral-600 dark:bg-white/10 dark:text-neutral-300',
  USED: 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400',
};

const productHref = `${BASE_URL}p/${deal.product_slug}/`;
const priceToShow = deal.landed_price_cents ?? deal.price_cents;
const showsLandedNote = deal.landed_price_cents !== null && deal.landed_price_cents !== deal.price_cents;
const outboundUrl = safeRetailerUrl(deal.retailer_url, deal.retailer_slug);
const referenceCents = deal.reference?.cents ?? deal.claimed_reference?.cents ?? null;
const caption = discountReferenceCaption(deal);
const productName = displayProductName(deal.product_name, deal.product_slug);
const imageAlt = `${productName}, ${deal.variant_label}`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200/80 bg-white shadow-[var(--shadow-card)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow-card-hover)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 dark:border-white/10 dark:bg-neutral-900"
  data-deal-card
  data-category={deal.category}
  data-retailer={deal.retailer_slug}
  data-condition-group={deal.condition === 'NEW' ? 'new' : 'used'}
  data-discount={deal.discount_pct}
  data-price={priceToShow}
  data-confirmed-at={deal.last_confirmed_at}
>
  <a href={productHref} class="block focus:outline-none" tabindex="-1" aria-hidden="true">
    <ProductImage src={deal.image_url} alt={imageAlt} eager={false} />
  </a>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex flex-wrap items-center gap-2">
      <span class:list={['inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide', laneClass[deal.lane]]}>
        {laneLabel[deal.lane]}
      </span>
      <ConditionBadge condition={deal.condition} />
      {deal.availability === 'STORE_ONLY' && (
        <span class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-[11px] font-semibold text-neutral-600 dark:bg-white/10 dark:text-neutral-300">
          In store only
        </span>
      )}
    </div>

    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-neutral-400 dark:text-neutral-500">
        {categoryLabel(deal.category)} · {deal.brand}
      </p>
      <h3 class="mt-0.5 text-base font-semibold leading-snug text-neutral-900 dark:text-white">
        <a href={productHref} class="hover:underline focus:underline">
          {productName}
        </a>
      </h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">{deal.variant_label}</p>
    </div>

    <div class="mt-1 border-t border-neutral-100 pt-3 dark:border-white/10">
      <DiscountPriceBlock
        pct={deal.discount_pct}
        currentCents={priceToShow}
        referenceCents={referenceCents}
        caption={caption}
        tier={deal.deal_quality_tier ?? null}
        size="card"
        shippedNote={showsLandedNote}
      />
    </div>

    {deal.lane !== 'CLAIMED' && deal.claimed_reference?.inflated_vs_reference && (
      <p class="text-xs italic text-neutral-400 dark:text-neutral-500">
        {deal.retailer_name ?? deal.retailer_slug}'s {deal.claimed_reference.kind === 'MSRP' ? 'MSRP' : 'listed price'} is higher than any
        price we've tracked.
      </p>
    )}

    <div class="mt-auto flex items-center justify-between pt-1 text-xs text-neutral-500 dark:text-neutral-400">
      <span>{deal.retailer_name ?? deal.retailer_slug} · checked {formatRelativeTime(deal.last_confirmed_at)}</span>
    </div>

    {outboundUrl ? (
      <a
        href={outboundUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-neutral-700 focus-visible:outline-offset-2 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        data-testid="deal-outbound-link"
      >
        View at {deal.retailer_name ?? deal.retailer_slug}
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    ) : (
      <p
        class="inline-flex items-center justify-center rounded-full bg-neutral-100 px-4 py-2.5 text-sm font-semibold text-neutral-500 dark:bg-white/10 dark:text-neutral-400"
        data-testid="deal-outbound-link-unavailable"
      >
        Link unavailable
      </p>
    )}
  </div>
</article>
