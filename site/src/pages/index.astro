---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealCard from '../components/DealCard.astro';
import FilterBar from '../components/FilterBar.astro';
import EmptyDealsState from '../components/EmptyDealsState.astro';
import NoDealsYet from '../components/NoDealsYet.astro';
import FeedStatusBanner from '../components/FeedStatusBanner.astro';
import { loadDeals, loadMeta } from '../lib/feed';
import { SITE_TAGLINE } from '../lib/site-config';
import type { Deal } from '../lib/types';

let deals: Deal[] = [];
let loadError: string | null = null;

const meta = await loadMeta();

try {
  const feed = await loadDeals();
  // CLAIMED-lane deals (a retailer's own claimed "MSRP"/"was" price, not a
  // price we've observed elsewhere) are hidden for now -- we don't yet have
  // enough of our own price history to sanity-check a retailer's claim, so
  // showing them risks amplifying an inflated "was" price as if it were a
  // real discount. The `Lane` type and CLAIMED rendering in DealCard stay in
  // place so this can be re-enabled once we have that history.
  deals = feed.deals.filter((deal) => deal.lane !== 'CLAIMED');
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Unknown error loading the deals feed.';
}

// Verified deals first, then retailer-claimed, then used -- matches the
// publication order in the architecture doc (section 6.3) -- with the
// biggest discount first within each lane. The sort control on the page
// can override this to a pure discount/price/newest ordering.
const laneOrder: Record<Deal['lane'], number> = { VERIFIED: 0, CLAIMED: 1, USED: 2 };
const orderedDeals = [...deals].sort((a, b) => {
  const laneDiff = laneOrder[a.lane] - laneOrder[b.lane];
  if (laneDiff !== 0) return laneDiff;
  return b.discount_pct - a.discount_pct;
});

const categories = Array.from(new Set(deals.map((d) => d.category)));
const retailers = Array.from(new Map(deals.map((d) => [d.retailer_slug, { slug: d.retailer_slug, name: d.retailer_name ?? d.retailer_slug }])).values());

const biggestDiscount = deals.length > 0 ? Math.max(...deals.map((d) => d.discount_pct)) : null;
---

<BaseLayout>
  <FeedStatusBanner meta={meta} />

  <section class="border-b border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-600 dark:text-accent-500">
        {deals.length > 0 ? `${deals.length} live deal${deals.length === 1 ? '' : 's'}` : 'Fishing gear deals'}
      </p>
      <h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl">
        Deep discounts on fishing gear{biggestDiscount !== null && (
          <>
            , up to <span class="text-accent-600 dark:text-accent-500">{Math.round(biggestDiscount)}% off</span>
          </>
        )}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-neutral-600 dark:text-neutral-400">{SITE_TAGLINE}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    {loadError ? (
      <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-red-800 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-400" role="alert">
        <p class="font-semibold">We couldn't load today's deals.</p>
        <p class="mt-1 text-sm">
          Something went wrong reaching our price feed ({loadError}). This is on us, not your
          connection — please check back shortly.
        </p>
      </div>
    ) : deals.length === 0 ? (
      <NoDealsYet />
    ) : (
      <>
        <div class="mb-6">
          <FilterBar categories={categories} retailers={retailers} />
        </div>

        <div id="deals-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {orderedDeals.map((deal) => (
            <DealCard deal={deal} />
          ))}
        </div>
        <EmptyDealsState hidden={true} />
      </>
    )}
  </div>
</BaseLayout>
