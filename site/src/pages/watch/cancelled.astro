---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Watch cancelled">
  <div class="mx-auto max-w-lg px-4 py-16 text-center sm:px-6">
    <h1 class="text-2xl font-bold text-slate-900">Price alerts aren't live yet</h1>
    <p class="mt-3 text-slate-600">
      This link is a placeholder for our upcoming price-alert feature. There's no watch to cancel
      because the feature hasn't launched.
    </p>
    <a href="/" class="mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
      Back to deals
    </a>
  </div>
</BaseLayout>
