---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BASE_URL } from '../../lib/site-config';
---

<BaseLayout title="Watch confirmed">
  <div class="mx-auto max-w-lg px-4 py-16 text-center sm:px-6">
    <h1 class="text-2xl font-bold text-neutral-900 dark:text-white">Price alerts aren't live yet</h1>
    <p class="mt-3 text-neutral-600 dark:text-neutral-400">
      This link is a placeholder for our upcoming price-alert feature. Nothing was confirmed because
      there's nothing to confirm yet — check back soon.
    </p>
    <a
      href={BASE_URL}
      class="mt-6 inline-block rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
    >
      Back to deals
    </a>
  </div>
</BaseLayout>
