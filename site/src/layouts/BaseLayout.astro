---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE, BASE_URL } from '../lib/site-config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_TAGLINE } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white dark:focus:bg-white dark:focus:text-neutral-900"
    >
      Skip to main content
    </a>
    <header class="sticky top-0 z-40 border-b border-neutral-200/80 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-neutral-950/80">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6">
        <a href={BASE_URL} class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white">
          {SITE_NAME}
        </a>
        <nav aria-label="Primary">
          <ul class="flex items-center gap-5 text-sm font-medium text-neutral-600 dark:text-neutral-400">
            <li><a class="transition-colors hover:text-neutral-900 dark:hover:text-white" href={BASE_URL}>Deals</a></li>
            <li><a class="transition-colors hover:text-neutral-900 dark:hover:text-white" href={`${BASE_URL}how-we-verify/`}>How we verify</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-16 border-t border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-neutral-500 dark:text-neutral-400 sm:px-6">
        <p>
          {SITE_NAME} tracks publicly listed prices at a handful of fishing gear retailers and only
          publishes drops of 50% or more. We link out to retailers directly — no affiliate tags.
        </p>
        <nav aria-label="Footer" class="mt-4 flex flex-wrap gap-4">
          <a class="hover:text-neutral-700 hover:underline dark:hover:text-neutral-200" href={`${BASE_URL}how-we-verify/`}>How we verify deals</a>
          <a class="hover:text-neutral-700 hover:underline dark:hover:text-neutral-200" href={`${BASE_URL}bot/`}>About our crawler</a>
          <a class="hover:text-neutral-700 hover:underline dark:hover:text-neutral-200" href={`${BASE_URL}privacy/`}>Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
